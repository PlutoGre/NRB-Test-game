# Machine-local debugging, emulator images and original duplicate archive.
/.debug/
/src.7z

# Portable tools are fetched by the deployment entry point on the target PC.
/deployment/.bootstrap/
/deployment/download-cache/
/deployment/github-upload/
/OnePieceServer/
/runtime/
/outputs/
/tools/

# Generated clients, native intermediates and IDE caches. Keep library archives
# and shared libraries outside these build directories: legacy targets need them.
**/.svn/
**/.idea/
**/.metadata/
**/.settings/
**/ipch/
**/obj/
**/bin/
**/build/
**/dist/
**/generated/
**/Debug*/
**/Release*/
**/DerivedData/
**/__pycache__/
*.pyc
*.pyo
*.obj
*.o
*.pdb
*.ipch
*.sdf
*.opensdf
*.ilk
*.idb
*.tlog
*.lastbuildstate
*.ncb
