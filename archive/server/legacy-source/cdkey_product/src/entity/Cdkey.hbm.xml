<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="entity">
	<class name="Cdkey" table="cdkey" dynamic-update="true" dynamic-insert="true">
		<id name="cd_key" column="cd_key">
			<generator class="assigned" />
		</id>
		<property name="create_time" column="create_time" type="int"></property>
		<property name="used_time" column="used_time" type="int"></property>
		<property name="playerid" column="playerid" type="int"></property>
		<property name="status" column="status" type="int"></property>
	</class>
</hibernate-mapping>
